<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ff5252">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/registationlogoimg"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/registationlogoimg" />

            <TextView
                android:id="@+id/donortxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_toEndOf="@+id/registationlogoimg"
                android:text="Donor"
                android:layout_marginStart="-10dp"
                android:textColor="@color/white"
                android:textSize="35sp"
                android:textStyle="bold"
                android:textAlignment="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/donortxt"
                android:textAlignment="center"
                android:layout_toEndOf="@+id/registationlogoimg"
                android:text="Registation"
                android:layout_marginStart="-10dp"
                android:textColor="@color/white"
                android:textSize="35sp"
                android:textStyle="bold" />


            <!--        Name-->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/donorname"
                style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_below="@+id/registationlogoimg"
                android:layout_marginHorizontal="30dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/background_box"
                android:hint="Full name"
                tools:ignore="RtlSymmetry">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/baseline_person_24"
                    android:drawablePadding="5dp"
                    android:importantForAutofill="no" />

            </com.google.android.material.textfield.TextInputLayout>

            <!--            username-->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/donorusername"
                style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_below="@+id/donorname"
                android:layout_marginHorizontal="30dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/background_box"
                android:hint="Username"
                android:importantForAutofill="no"
                tools:ignore="RtlSymmetry">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/baseline_person_24"
                    android:drawablePadding="5dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!--            phone number-->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/donorphonenumber"
                style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_below="@+id/donorusername"
                android:layout_marginHorizontal="30dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/background_box"
                android:hint="Phone Number"
                tools:ignore="RtlSymmetry">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/baseline_phone_android_24"
                    android:drawablePadding="5dp"
                    android:inputType="number"
                    android:maxLength="10"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!--            password-->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/donorpassword"
                style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_below="@+id/donorphonenumber"
                android:layout_marginHorizontal="30dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/background_box"
                android:hint="Password"
                android:importantForAutofill="no"
                app:passwordToggleEnabled="true"
                tools:ignore="RtlSymmetry">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/baseline_password_24"
                    android:drawablePadding="5dp"
                    android:inputType="textPassword" />

            </com.google.android.material.textfield.TextInputLayout>

            <!--        Email-->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/donoremail"
                style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_below="@+id/donorpassword"
                android:layout_marginHorizontal="30dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/background_box"
                android:hint="Email"
                tools:ignore="RtlSymmetry">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/baseline_email_24"
                    android:drawablePadding="5dp"
                    android:inputType="textEmailAddress" />

            </com.google.android.material.textfield.TextInputLayout>


            <!--        Gender and Blood Group-->
            <LinearLayout
                android:id="@+id/genderbloodgroup"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_below="@+id/donoremail"
                android:layout_marginHorizontal="30dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
                    android:layout_width="170dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="30dp"
                    android:background="@drawable/background_box"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    tools:ignore="RtlSymmetry">


                    <Spinner
                        android:id="@+id/donorbloodgroup"
                        android:layout_width="170dp"
                        android:layout_height="60dp"
                        android:entries="@array/blood_groups"
                        android:textAlignment="center" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
                    android:layout_width="170dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="30dp"
                    android:background="@drawable/background_box"
                    android:layout_weight="1"
                    tools:ignore="RtlSymmetry">

                    <Spinner
                        android:id="@+id/donorgender"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:entries="@array/gender"
                        android:textAlignment="center"
                        />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!--        Govt Id-->

            <LinearLayout
                android:id="@+id/iddetails"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_below="@+id/genderbloodgroup"
                android:layout_marginHorizontal="30dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
                    android:layout_width="170dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="30dp"
                    android:background="@drawable/background_box"
                    android:layout_weight="1"
                    tools:ignore="RtlSymmetry">

                    <Spinner
                        android:id="@+id/donorgovtidname"
                        android:layout_width="170dp"
                        android:layout_height="60dp"
                        android:entries="@array/govt_id"
                        android:textAlignment="center" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/donorgovtidnum"
                    style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="30dp"
                    android:background="@drawable/background_box"
                    android:hint="Id number"
                    android:layout_weight="@integer/material_motion_duration_long_1"
                    tools:ignore="RtlSymmetry">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:drawableStart="@drawable/baseline_numbers_24"
                        android:drawablePadding="5dp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>


            <!--        Address house and use location -->
            <LinearLayout
                android:id="@+id/fulladdress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iddetails"
                android:orientation="vertical">

<!--                house and location button-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="30dp"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/donoraddresshouse"
                        style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:background="@drawable/background_box"
                        android:hint="House, Locality"
                        android:layout_weight="1"
                        tools:ignore="RtlSymmetry">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="no"
                            android:background="@android:color/transparent"
                            android:drawableStart="@drawable/baseline_add_location_24"
                            android:drawablePadding="5dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/currentlocation"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="5dp"
                        android:orientation="horizontal"
                        android:background="@drawable/background_box"
                        android:backgroundTint="#6750a4"
                        android:layout_weight="1">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/baseline_my_location_24"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="30sp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Use Location"
                            android:padding="15dp"
                            android:paddingStart="8dp"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <!--            District and City-->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="30dp"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/donorcity"
                        style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:background="@drawable/background_box"
                        android:hint="City"
                        android:layout_weight="@integer/material_motion_duration_long_1"
                        tools:ignore="RtlSymmetry">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="no"
                            android:background="@android:color/transparent"
                            android:drawableStart="@drawable/baseline_add_location_24"
                            android:drawablePadding="5dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/donordistrict"
                        style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginBottom="30dp"
                        android:background="@drawable/background_box"
                        android:hint="District"
                        android:layout_weight="@integer/material_motion_duration_long_1"
                        tools:ignore="RtlSymmetry">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:drawableStart="@drawable/baseline_add_location_24"
                            android:drawablePadding="5dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!--            pin code and state-->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="30dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/donorstate"
                        style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginBottom="30dp"
                        android:background="@drawable/background_box"
                        android:hint="State"
                        android:layout_weight="@integer/material_motion_duration_long_1"
                        tools:ignore="RtlSymmetry">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:drawableStart="@drawable/baseline_add_location_24"
                            android:drawablePadding="5dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/donorpincode"
                        style="@style/ThemeOverlay.Material3.TextInputEditText.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginBottom="30dp"
                        android:background="@drawable/background_box"
                        android:hint="Pin Code"
                        android:layout_weight="@integer/material_motion_duration_long_1"
                        tools:ignore="RtlSymmetry">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:drawableStart="@drawable/baseline_add_location_24"
                            android:drawablePadding="5dp"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </LinearLayout>

            <!--        Next Button-->

            <FrameLayout
                android:id="@+id/frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/fulladdress">

                <Button
                    android:id="@+id/donorBtnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="15dp"
                    android:text="Register"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/donorregisterProgressbar"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:id="@+id/donorhaveaccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/frame"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="10dp"
                android:text="Already registered? Login"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

        </RelativeLayout>

    </LinearLayout>


</ScrollView>
