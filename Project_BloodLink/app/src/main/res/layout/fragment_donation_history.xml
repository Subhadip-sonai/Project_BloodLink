<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".admin.home.agencyRequestlist.AgencyRequestlist">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/individuals"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Individuals"
                android:textAlignment="center"
                android:textStyle="bold"
                android:paddingVertical="5dp"
                android:layout_weight="1"
                android:textSize="20sp"/>
            <TextView
                android:id="@+id/camps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Blood Camps"
                android:textStyle="bold"
                android:paddingVertical="5dp"
                android:textAlignment="center"
                android:layout_weight="1"
                android:textSize="20sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/nothingpresent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="No Donation"
            android:textSize="16sp"
            android:textAlignment="center"
            android:visibility="gone"/>

        <ProgressBar
            android:id="@+id/progressbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/campsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/txt"
            tools:listitem="@layout/donation_history_camps_recyclerview_item_list"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/individualsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/txt"
            tools:listitem="@layout/donation_history_individuals_recyclerview_item_list"/>

    </RelativeLayout>


</FrameLayout>