<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".mainactivity.home.findDonorRecyclerview.FindDonor">

    <TextView
        android:id="@+id/nothingPresent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:layout_gravity="center"
        android:visibility="gone"
        />

    <ProgressBar
        android:id="@+id/progressbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/enterTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:layout_marginEnd="115dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="10dp"
            tools:ignore="SmallSp" />

        <Button
            android:id="@+id/enterTxtbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp"
            android:text="Search"
            android:layout_marginTop="3dp"
            />


        <Spinner
            android:id="@+id/donor_redious_find"
            android:layout_width="match_parent"
            android:layout_marginEnd="110dp"
            android:layout_marginStart="15dp"
            android:layout_marginVertical="10dp"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:entries="@array/donor_redious"
            android:layout_below="@+id/enterTxt"/>

        <Button
            android:id="@+id/radious_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp"
            android:text="Filter"
            android:layout_below="@+id/enterTxt"
            />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerlistfinddonor"
        android:layout_below="@id/donor_redious_find"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:listitem="@layout/find_donor_recycleview_item_list" />

    </RelativeLayout>

</FrameLayout>